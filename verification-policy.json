{
  "schemaVersion": 1,
  "description": "Single fail-closed source of truth for RendererIOS verification routing.",
  "gateOrder": [
    "policy-contracts",
    "contracts",
    "device-facts",
    "tile-contracts",
    "forward-contracts",
    "strict-compile",
    "build-off",
    "build-on",
    "build-tile",
    "build-forward",
    "build-additive-a-hdr",
    "build-additive-b-hdr",
    "build-multiply2-a-hdr",
    "build-multiply2-b-hdr",
    "full"
  ],
  "riskOrder": [
    "documentation",
    "assets",
    "diagnostics",
    "production",
    "device-facts",
    "tile",
    "forward",
    "shared-runtime",
    "infrastructure",
    "unknown"
  ],
  "requiredFullPaths": [
    "verification-policy.json",
    "scripts/classify_verification.py",
    "scripts/ci_verification.py",
    "scripts/ci_contracts.command",
    "scripts/ci_build_profile.command",
    "ios/tests/test_verification_classifier.py",
    "ios/tests/test_verification_router.py",
    "ios/tests/test_ci_verification.py",
    "scripts/verify.command",
    "scripts/execute_verification_gates.py",
    "scripts/verify-local-build.command",
    "CMakePresets.json",
    ".github/workflows/renderer-ios.yml",
    "CMakeLists.txt",
    ".gitmodules",
    "lib/Tempest",
    "shader/ios-metal/shading-prototypes.metal"
  ],
  "rules": [
    {
      "id": "verification-infrastructure",
      "risk": "infrastructure",
      "paths": [
        "verification-policy.json",
        "scripts/classify_verification.py",
        "scripts/ci_verification.py",
        "scripts/ci_contracts.command",
        "scripts/ci_build_profile.command",
        "ios/tests/test_verification_classifier.py",
        "ios/tests/test_verification_router.py",
        "ios/tests/test_ci_verification.py",
        "scripts/verify.command",
        "scripts/execute_verification_gates.py",
        "scripts/verify-local-build.command",
        "CMakePresets.json",
        ".github/workflows/**"
      ],
      "gates": [
        "full"
      ],
      "reason": "changed verification infrastructure"
    },
    {
      "id": "build-infrastructure",
      "risk": "infrastructure",
      "paths": [
        "CMakeLists.txt",
        "cmake/**",
        ".gitmodules",
        "ios/patches/**"
      ],
      "gates": [
        "full"
      ],
      "reason": "changed build, submodule, or patch infrastructure"
    },
    {
      "id": "tempest-or-shaders",
      "risk": "infrastructure",
      "paths": [
        "lib/Tempest",
        "lib/Tempest/**",
        "shader/**"
      ],
      "gates": [
        "full"
      ],
      "reason": "changed Tempest or shader input shared by every profile"
    },
    {
      "id": "device-facts",
      "risk": "device-facts",
      "paths": [
        "game/graphics/iosdevicecapabilities.*",
        "game/graphics/iosdevicefactscollector.*",
        "ios/tests/iosdevicecapabilities.cpp",
        "ios/tests/iosdevicefactscollector.cpp",
        "ios/device-test/validate-device-facts-log.py"
      ],
      "gates": [
        "device-facts",
        "strict-compile",
        "build-off",
        "build-on"
      ],
      "reason": "changed native device capability facts"
    },
    {
      "id": "tile-prototype",
      "risk": "tile",
      "paths": [
        "game/graphics/iosshadingprototypepipeline*",
        "game/graphics/iosshadingprototypeplan.*",
        "game/graphics/iosshadingprototypeshaderabi.h",
        "game/graphics/iosshadingprototypetileprobe.*",
        "ios/tests/iosshadingprototypepipeline.cpp",
        "ios/tests/iosshadingprototypeplan.cpp",
        "ios/tests/iosshadingprototypeshader.cpp",
        "ios/tests/iosshadingprototypetileprobe.cpp",
        "ios/device-test/validate-shading-prototype-tile-self-test-log.py"
      ],
      "gates": [
        "tile-contracts",
        "build-tile",
        "build-off"
      ],
      "reason": "changed Tile shading prototype"
    },
    {
      "id": "forward-prototype",
      "risk": "forward",
      "paths": [
        "game/graphics/iosshadingprototypeforwardpipeline*",
        "game/graphics/iosshadingprototypeforwardprobe.*",
        "ios/tests/iosshadingprototypeforwardpipeline.cpp",
        "ios/tests/iosshadingprototypeforwardprobe.cpp",
        "ios/device-test/validate-shading-prototype-forward-self-test-log.py",
        "ios/device-test/validate-shading-prototype-forward-gpudebug-trace.py"
      ],
      "gates": [
        "forward-contracts",
        "build-forward",
        "build-off"
      ],
      "reason": "changed Forward shading prototype"
    },
    {
      "id": "p21e1b-additive-device-group",
      "risk": "diagnostics",
      "paths": [
        "scripts/verify_ios_additive_device_group.command",
        "scripts/test-p21e1b-additive-launch-adapter.py",
        "scripts/test-p21e1b-additive-performance.py",
        "ios/device-test/run-additive-gpu-group.sh",
        "ios/device-test/run-additive-performance-test.sh",
        "ios/device-test/validate-additive-device-group.py",
        "ios/device-test/validate-additive-gpu-pair.py",
        "ios/device-test/validate-additive-performance-trace.py",
        "ios/device-test/specs/p21e1b-static-additive-v1.json",
        "ios/device-test/specs/p21e1b-static-additive-group-v1.json"
      ],
      "gates": [
        "contracts",
        "build-off",
        "build-on",
        "build-additive-a-hdr",
        "build-additive-b-hdr"
      ],
      "reason": "changed P2.1e1b grouped device, launch, performance, pair, or specification contract"
    },
    {
      "id": "p21e1b-device-integrity",
      "risk": "shared-runtime",
      "paths": [
        "game/graphics/iosdeviceintegritymanifest.h",
        "game/graphics/iosdeviceintegritymanifest.cpp",
        "ios/tests/iosdeviceintegritymanifest.cpp"
      ],
      "gates": [
        "contracts",
        "strict-compile",
        "build-off",
        "build-on",
        "build-additive-a-hdr",
        "build-additive-b-hdr"
      ],
      "reason": "changed diagnostics-only P2.1e1b product integrity runtime or host contract"
    },
    {
      "id": "device-harness",
      "risk": "diagnostics",
      "paths": [
        "ios/device-test/**"
      ],
      "excludePaths": [
        "ios/device-test/validate-device-facts-log.py",
        "ios/device-test/validate-shading-prototype-tile-self-test-log.py",
        "ios/device-test/validate-shading-prototype-forward-self-test-log.py",
        "ios/device-test/validate-shading-prototype-forward-gpudebug-trace.py",
        "ios/device-test/run-additive-gpu-group.sh",
        "ios/device-test/run-additive-performance-test.sh",
        "ios/device-test/validate-additive-device-group.py",
        "ios/device-test/validate-additive-gpu-pair.py",
        "ios/device-test/validate-additive-performance-trace.py",
        "ios/device-test/specs/p21e1b-static-additive-v1.json",
        "ios/device-test/specs/p21e1b-static-additive-group-v1.json"
      ],
      "gates": [
        "contracts",
        "build-on"
      ],
      "reason": "changed diagnostics or physical-device harness"
    },
    {
      "id": "remaining-material-source-census",
      "risk": "diagnostics",
      "paths": [
        "game/graphics/iosremainingmaterialcensus.h",
        "game/graphics/iossceneextractor.h",
        "game/graphics/iossceneextractor.cpp",
        "game/graphics/rendererios.cpp",
        "ios/tests/iosremainingmaterialcensus.cpp",
        "ios/tests/iossceneextractorplan.cpp",
        "ios/device-test/validate-remaining-material-census-log.py",
        "ios/device-test/validate-remaining-material-device-attestation.py",
        "ios/device-test/specs/p21e2a-remaining-material-census-device-v1.json",
        "ios/simulator-test/RemainingMaterialCensusAdapter/**",
        "ios/simulator-test/RemainingMaterialCensusAdapter.xcodeproj/**",
        "ios/simulator-test/fixtures/p21e2a-remaining-material-census-v1.json",
        "ios/simulator-test/specs/p21e2a-remaining-material-census-v1.json",
        "ios/simulator-test/run-remaining-material-census.sh",
        "scripts/verify_ios_remaining_material_census.command"
      ],
      "gates": [
        "contracts",
        "strict-compile",
        "build-off",
        "build-on"
      ],
      "reason": "changed diagnostics-only remaining-material census, validator, or simulator adapter"
    },
    {
      "id": "additive-source-census",
      "risk": "diagnostics",
      "paths": [
        "game/graphics/iosadditivesourcecensus.h",
        "game/graphics/iossceneextractor.h",
        "game/graphics/iossceneextractor.cpp",
        "game/graphics/rendererios.cpp",
        "ios/tests/iosadditivesourcecensus.cpp",
        "ios/tests/iossceneextractorplan.cpp",
        "ios/device-test/validate-additive-source-census-log.py",
        "ios/device-test/specs/p21e1a-additive-census-device-v1.json",
        "ios/simulator-test/**",
        "scripts/verify_ios_additive_census.command"
      ],
      "gates": [
        "contracts",
        "strict-compile",
        "build-off",
        "build-on"
      ],
      "reason": "changed diagnostics-only Additive source census or its simulator adapter"
    },
    {
      "id": "p21e2b-multiply2-gpu-vertical",
      "risk": "shared-runtime",
      "paths": [
        "game/graphics/iosgpuscene.h",
        "game/graphics/iosgpuscene.mm",
        "game/graphics/iosgpusceneplan.h",
        "game/graphics/iosmetalcontext.cpp",
        "game/graphics/iosmultiply2inputartifact.h",
        "game/graphics/iosmultiply2inputartifact.cpp",
        "game/graphics/iossceneextractor.h",
        "game/graphics/iossceneextractorplan.h",
        "game/graphics/iosscenesnapshot.h",
        "game/graphics/iosscenesnapshot.cpp",
        "ios/tests/iosmultiply2inputartifact.cpp",
        "ios/tests/iosmultiply2runtimecontract.cpp",
        "ios/tests/iosgpusceneplan.cpp",
        "ios/tests/iosscenecontract.cpp",
        "ios/tests/iossceneextractorplan.cpp",
        "scripts/verify_ios_multiply2_gpu.command"
      ],
      "gates": [
        "contracts",
        "strict-compile",
        "build-off",
        "build-on",
        "build-additive-a-hdr",
        "build-additive-b-hdr",
        "build-multiply2-a-hdr",
        "build-multiply2-b-hdr"
      ],
      "reason": "changed P2.1e2b Static/None Multiply2 GPU vertical"
    },
    {
      "id": "renderer-ios-runtime",
      "risk": "shared-runtime",
      "paths": [
        "game/graphics/ios*"
      ],
      "excludePaths": [
        "game/graphics/iosdevicecapabilities.*",
        "game/graphics/iosdevicefactscollector.*",
        "game/graphics/iosshadingprototypepipeline*",
        "game/graphics/iosshadingprototypeplan.*",
        "game/graphics/iosshadingprototypeshaderabi.h",
        "game/graphics/iosshadingprototypetileprobe.*",
        "game/graphics/iosshadingprototypeforwardpipeline*",
        "game/graphics/iosshadingprototypeforwardprobe.*",
        "game/graphics/iosdeviceintegritymanifest.h",
        "game/graphics/iosdeviceintegritymanifest.cpp",
        "game/graphics/iosremainingmaterialcensus.h"
      ],
      "gates": [
        "contracts",
        "strict-compile",
        "build-off",
        "build-on"
      ],
      "reason": "changed shared RendererIOS runtime"
    },
    {
      "id": "renderer-ios-contract-tests",
      "risk": "shared-runtime",
      "paths": [
        "ios/tests/ios*",
        "scripts/validate-scene-source-census-log.py",
        "scripts/test-p21d2a-frame-animation-contract.py",
        "scripts/test-p21d2-frame-animation-vertical.py",
        "scripts/test-p21d2-frame-animation-device-parser.py"
      ],
      "excludePaths": [
        "ios/tests/iosdevicecapabilities.cpp",
        "ios/tests/iosdevicefactscollector.cpp",
        "ios/tests/iosshadingprototypepipeline.cpp",
        "ios/tests/iosshadingprototypeplan.cpp",
        "ios/tests/iosshadingprototypeshader.cpp",
        "ios/tests/iosshadingprototypetileprobe.cpp",
        "ios/tests/iosshadingprototypeforwardpipeline.cpp",
        "ios/tests/iosshadingprototypeforwardprobe.cpp",
        "ios/tests/iosdeviceintegritymanifest.cpp",
        "ios/tests/iosremainingmaterialcensus.cpp"
      ],
      "gates": [
        "contracts",
        "strict-compile",
        "build-off",
        "build-on"
      ],
      "reason": "changed RendererIOS host contract coverage"
    },
    {
      "id": "product-source",
      "risk": "shared-runtime",
      "paths": [
        "game/**"
      ],
      "excludePaths": [
        "game/graphics/ios*"
      ],
      "gates": [
        "contracts",
        "strict-compile",
        "build-off",
        "build-on"
      ],
      "reason": "changed product source shared by production and diagnostics"
    },
    {
      "id": "packaged-assets",
      "risk": "assets",
      "paths": [
        "assets/**",
        "Info.plist.in"
      ],
      "gates": [
        "build-off"
      ],
      "reason": "changed packaged asset or application metadata"
    },
    {
      "id": "documentation",
      "risk": "documentation",
      "paths": [
        "*.md",
        "docs/**"
      ],
      "gates": [
        "policy-contracts"
      ],
      "reason": "changed public documentation only"
    }
  ],
  "fallback": {
    "risk": "unknown",
    "gates": [
      "full"
    ],
    "reason": "unclassified path requires the full verification set"
  }
}
